# Application
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=salamasphere_dev
DB_USER=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=

# Notifications
SMS_PROVIDER=mobile_sasa
MOBILESASA_TOKEN=
MOBILESASA_BASE_URL=https://api.mobilesasa.com
MOBILESASA_SENDER_ID=MOBILESASA

# Optional alternate providers: console, esms_africa, twilio
SALAMASPHERE_PUBLIC_BASE_URL=https://api.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Evidence storage
EVIDENCE_STORAGE_BACKEND=local

# Optional future integrations
PUSH_NOTIFICATION_CREDENTIALS=